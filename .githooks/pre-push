#!/bin/sh
#
# pre-push: only `main` and `dev` may be pushed to a remote.
#
# Rationale (see CONTRIBUTING.md / CLAUDE.md): agent working branches such as
# claude/* are local scratch space. Publishing them clutters the public repo,
# triggers CI on unreviewed work, and makes the branch that Addon Manager
# tracks ambiguous. Release tags are allowed so a future v0.x.y can be cut.
#
# Installed via `git config core.hooksPath .githooks` (tracked in-repo, so it
# survives clones and worktrees). Bypass deliberately with `git push --no-verify`.

allowed_ref() {
    case "$1" in
        refs/heads/main|refs/heads/dev) return 0 ;;
        refs/tags/*)                    return 0 ;;
        *)                              return 1 ;;
    esac
}

status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ -z "$remote_ref" ] && continue
    if ! allowed_ref "$remote_ref"; then
        echo "pre-push: refusing to push '$remote_ref'." >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    cat >&2 <<'EOF'

Only 'main' and 'dev' (and release tags) may be pushed to origin.

Agent/feature branches stay local. To land work:
    git switch dev && git merge <your-branch>   # integrate locally
    git push origin dev                         # then push dev

Override for a one-off:  git push --no-verify
EOF
fi

exit $status
